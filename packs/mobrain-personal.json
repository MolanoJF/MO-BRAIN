{
  "api_version": "gbrain-schema-pack-v1",
  "name": "mobrain-personal",
  "version": "2.0.0",
  "description": "Mo-brain's personal ontology for the professional self. Extends mobrain-core with journal, areas, goals, decisions, ideas, writing and life records.",
  "gbrain_min_version": "0.60.230",
  "extends": "mobrain-core",
  "borrow_from": [],
  "page_types": [
    {
      "name": "journal",
      "primitive": "temporal",
      "path_prefixes": [
        "journal/",
        "life/diary/"
      ],
      "aliases": [
        "diary"
      ],
      "extractable": true,
      "expert_routing": false
    },
    {
      "name": "area",
      "primitive": "concept",
      "path_prefixes": [
        "areas/"
      ],
      "aliases": [],
      "extractable": false,
      "expert_routing": false
    },
    {
      "name": "goal",
      "primitive": "concept",
      "path_prefixes": [
        "goals/"
      ],
      "aliases": [],
      "extractable": false,
      "expert_routing": false
    },
    {
      "name": "decision",
      "primitive": "annotation",
      "path_prefixes": [
        "decisions/"
      ],
      "aliases": [],
      "extractable": true,
      "expert_routing": false
    },
    {
      "name": "idea",
      "primitive": "concept",
      "path_prefixes": [
        "ideas/"
      ],
      "aliases": [],
      "extractable": false,
      "expert_routing": false
    },
    {
      "name": "writing",
      "primitive": "media",
      "path_prefixes": [
        "writing/",
        "posts/",
        "newsletters/",
        "talks/"
      ],
      "aliases": [],
      "extractable": true,
      "expert_routing": false
    },
    {
      "name": "health_record",
      "primitive": "temporal",
      "path_prefixes": [
        "health/"
      ],
      "aliases": [],
      "extractable": true,
      "expert_routing": false
    },
    {
      "name": "finance_record",
      "primitive": "temporal",
      "path_prefixes": [
        "finances/"
      ],
      "aliases": [],
      "extractable": true,
      "expert_routing": false
    }
  ],
  "link_types": [
    {
      "name": "works_at",
      "inverse": "employs",
      "inference": {
        "regex": "\\b(works? at|employed by|works? for|joined|hired by|ceo of|cto of|cmo of)\\b",
        "ner_only": true
      }
    },
    {
      "name": "founded",
      "inverse": "founded_by",
      "inference": {
        "regex": "\\b(founded|founder of|co-?founded|started)\\b",
        "ner_only": true
      }
    },
    {
      "name": "advises",
      "inverse": "advised_by",
      "inference": {
        "regex": "\\b(advises|advisor|advising|advisor to)\\b",
        "ner_only": true
      }
    },
    {
      "name": "introduced",
      "inverse": "introduced_by"
    },
    {
      "name": "belongs_to",
      "inverse": "contains"
    },
    {
      "name": "serves",
      "inverse": "served_by"
    },
    {
      "name": "contributes_to",
      "inverse": "contributors"
    },
    {
      "name": "affects",
      "inverse": "affected_by"
    },
    {
      "name": "decided_in"
    },
    {
      "name": "provider_for",
      "inverse": "provided_by"
    },
    {
      "name": "owes_to"
    },
    {
      "name": "awaiting_reply_from"
    }
  ],
  "frontmatter_links": [
