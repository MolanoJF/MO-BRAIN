# Exact gbrain version. NEVER use a moving tag such as latest-stable (G1).
GBRAIN_VERSION=0.50.0.0

# Slice 0 Postgres (compose/docker-compose.slice0.yml only). No host port is
# published by the base compose. POSTGRES_PASSWORD is shared with the
# production stack below; slice0 falls back to a fixed dev default when it
# is unset, the production stack requires it to be set explicitly.
GBRAIN_DB=gbrain

# Set to 1 only in a scratch shell where you accept a published Postgres port.
BRAINSTAND_DEV_EXPOSE_PG=0

# Required by both compose files -- docker-compose.yml's `${DOMAIN:?required}`
# is interpolated before docker-compose.dev.yml is ever merged in, so the dev
# override cannot supply this for you. For local development with
# docker-compose.dev.yml, set DOMAIN=localhost (Caddy then issues certs from
# its own internal CA instead of ACME). The value below is a PRODUCTION
# placeholder: replace it with your real domain before deploying.
DOMAIN=brain.example.com
BRAINSTAND_VERSION=dev
WORKER_CONCURRENCY=2

# Generated by scripts/install.sh. Rotating ENCRYPTION_KEY requires the
# documented secret-rotation flow; losing it makes every stored secret
# unrecoverable, so it is backed up SEPARATELY from the database.
POSTGRES_PASSWORD=
OPS_RPC_TOKEN=
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
