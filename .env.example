# Exact gbrain version. NEVER use a moving tag such as latest-stable (G1).
GBRAIN_VERSION=0.50.0.0

# Exact agent-harness version for the optional agent-runner (G1, same rule as
# GBRAIN_VERSION: a moving harness reference is a CI failure). This is the
# version Task 1 proved installs; the image tag AND the build ARG both come
# from it. It is required with no compose default, mirroring GBRAIN_VERSION, so
# every deployment names a version even when it never enables the runner.
HARNESS_VERSION=2.1.274

# The agent runner is optional (D12) and OFF by default: it is a compose
# profile, so a plain `docker compose up` never starts it. A deployment that
# only connects members' own agents sets neither of the two variables below.
# Enable it deliberately — this container runs model-written code against your
# brain, using your organization's API key, on a schedule, with nobody
# watching — by setting COMPOSE_PROFILES=runner and a RUNNER_TOKEN
# (scripts/install.sh asks in those words). With RUNNER_TOKEN empty the
# control plane answers 503 runner_disabled and the runner exits non-zero: an
# empty bearer must never authenticate.
# COMPOSE_PROFILES=runner
RUNNER_TOKEN=

# Slice 0 Postgres (compose/docker-compose.slice0.yml only). No host port is
# published by the base compose. POSTGRES_PASSWORD is shared with the
# production stack below; slice0 falls back to a fixed dev default when it
# is unset, the production stack requires it to be set explicitly.
GBRAIN_DB=gbrain

# Set to 1 only in a scratch shell where you accept a published Postgres port.
# MOBRAIN_DEV_EXPOSE_PG is the current name; BRAINSTAND_DEV_EXPOSE_PG is the
# legacy alias, kept for one release (D3 rename).
MOBRAIN_DEV_EXPOSE_PG=0
BRAINSTAND_DEV_EXPOSE_PG=0

# Required by both compose files -- docker-compose.yml's `${DOMAIN:?required}`
# is interpolated before docker-compose.dev.yml is ever merged in, so the dev
# override cannot supply this for you. For local development with
# docker-compose.dev.yml, set DOMAIN=localhost (Caddy then issues certs from
# its own internal CA instead of ACME). The value below is a PRODUCTION
# placeholder: replace it with your real domain before deploying.
DOMAIN=brain.example.com
# MOBRAIN_VERSION is current; BRAINSTAND_VERSION is the legacy alias older
# .env files carry. Compose reads the new name first, the old one second.
MOBRAIN_VERSION=dev
BRAINSTAND_VERSION=dev
WORKER_CONCURRENCY=2

# Scheduler loop period, in milliseconds. 15s is the shipped default: fine
# enough for a calendar slot and cheap for a mostly-idle control DB. The
# service is replica-safe (one leader via an advisory lock), so this is a
# latency knob, not a correctness one — do not lower it to "fix" a missed run.
SCHEDULER_TICK_MS=15000

# Generated by scripts/install.sh. Rotating ENCRYPTION_KEY requires the
# documented secret-rotation flow; losing it makes every stored secret
# unrecoverable, so it is backed up SEPARATELY from the database.
POSTGRES_PASSWORD=
OPS_RPC_TOKEN=
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
