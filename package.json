    "operations:emit": "bun run scripts/emit-operations.ts",
    "tutorial": "bun run scripts/tutorial.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
