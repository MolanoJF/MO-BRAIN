{
  "name": "brainstand",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:contract": "bun test test/contract",
    "test:integration:isolated": "bash scripts/test-isolated.sh test/integration",
    "test:contract:isolated": "bash scripts/test-isolated.sh test/contract",
    "test:e2e": "bun test --parallel=1 test/e2e",
    "test:build": "bash test/build/pin.test.sh",
    "lint:forbidden": "bun run scripts/lint-forbidden.ts",
    "stack:up": "docker compose -f compose/docker-compose.slice0.yml up -d --wait",
    "stack:down": "docker compose -f compose/docker-compose.slice0.yml down -v",
    "capability:capture": "bun run scripts/capture-capability.ts",
    "operations:emit": "bun run scripts/emit-operations.ts",
    "tutorial": "bun run scripts/tutorial.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
